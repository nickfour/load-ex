                if aimStatus == "Target" then
                    crosshairDot.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
                    if (tick() - lastFire) >= Config.FireDelay then
                        lastFire = tick()
                        pcall(function() mouse1click() end)
                    end
                elseif aimStatus == "Wall" then
                    crosshairDot.BackgroundColor3 = Color3.fromRGB(150, 150, 150)
                else
                    crosshairDot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                end
            end
            -- อัปเดต ESP จะทำงานก็ต่อเมื่อ Config.ESPActive เป็น true เท่านั้น
            pcall(UpdateESP)
        else
            if crosshairDot then crosshairDot.Position = UDim2.new(0, -100, 0, -100) end
        end
    end
end)

print("[System] Loaded! | Main: "..Config.MainKey.Name.." | UI: "..Config.UIKey.Name.." | ESP Default: OFF")