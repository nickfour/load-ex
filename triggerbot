local function CheckAimStatus()
    local mouseRay = LP:GetMouse().UnitRay
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.IgnoreWater = true
    local ignoreList = {LP.Character, Camera}
    rayParams.FilterDescendantsInstances = ignoreList

    local currentOrigin = mouseRay.Origin
    local currentDir = mouseRay.Direction
    local currentDist = Config.MaxRange

    for i = 1, 15 do
        local result = workspace:Raycast(currentOrigin, currentDir * currentDist, rayParams)
        if not result then return "None" end
        
        local hit = result.Instance
        local hitDist = (result.Position - currentOrigin).Magnitude
        local model = hit:FindFirstAncestorOfClass("Model")

        if model then
            local plr = Players:GetPlayerFromCharacter(model)
            local hum = model:FindFirstChildOfClass("Humanoid")
            if plr and plr ~= LP and hum and hum.Health > 0 then return "Target" end
        end

        if hit:FindFirstAncestorOfClass("Accessory") or hit:FindFirstAncestorOfClass("Tool") or hit.Name == "Handle" 
           or hit.Transparency > 0.1 or hit.CanCollide == false or hit.Material == Enum.Material.Glass then
            table.insert(ignoreList, hit)
            rayParams.FilterDescendantsInstances = ignoreList
            currentOrigin = result.Position + (currentDir.Unit * 0.1)
            currentDist = currentDist - hitDist - 0.1
            if currentDist <= 0 then return "None" end
        else
            if not Config.WallCheck then
                table.insert(ignoreList, hit)
                rayParams.FilterDescendantsInstances = ignoreList
                currentOrigin = result.Position + (currentDir.Unit * 0.1)
                currentDist = currentDist - hitDist - 0.1
                if currentDist <= 0 then return "None" end
            else
                return "Wall"
            end
        end
    end
    return "None"
end

local function CheckESPStatus(targetHead)
    if not targetHead or not targetHead.Parent then return false end
    
    local camPos = Camera.CFrame.Position
    local targetPos = targetHead.Position
    local dirToTarget = (targetPos - camPos)
    local totalDist = dirToTarget.Magnitude
    
    if totalDist <= 0 then return true end
    
    local currentDir = dirToTarget.Unit
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.IgnoreWater = true
    local ignoreList = {LP.Character, Camera}
    
    local currentOrigin = camPos
    local currentDist = totalDist

    for i = 1, 10 do
        rayParams.FilterDescendantsInstances = ignoreList
        local result = workspace:Raycast(currentOrigin, currentDir * currentDist, rayParams)
        if not result then return true end 
        
        local hit = result.Instance
        local hitDist = (result.Position - currentOrigin).Magnitude
        
        if hit:IsDescendantOf(targetHead.Parent) then return true end
        
        if hit:FindFirstAncestorOfClass("Accessory") or hit:FindFirstAncestorOfClass("Tool") or hit.Name == "Handle" 
           or hit.Transparency > 0.1 or hit.CanCollide == false or hit.Material == Enum.Material.Glass then
            table.insert(ignoreList, hit)
            currentOrigin = result.Position + (currentDir * 0.1)
            currentDist = currentDist - hitDist - 0.1
            if currentDist <= 0 then return false end
        else
            return false 
        end
    end
    return false
end

local function ClearESP()
    for _, plr in pairs(Players:GetPlayers()) do
        if plr.Character then
            local old = plr.Character:FindFirstChild(Config.ESP_NAME)
            if old then old:Destroy() end
        end
    end
end

local function CreateESP(player)
    pcall(function()
        if not player.Character or player == LP then return end
        local char = player.Character
        local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
        if not root then return end
        if player.Team and player.Team == LP.Team then return end
        if char:FindFirstChild(Config.ESP_NAME) then return end

        local espFolder = Instance.new("Folder")
        espFolder.Name = Config.ESP_NAME
        espFolder.Parent = char

        local highlight = Instance.new("Highlight")
        highlight.Name = "BodyHighlight"
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillColor = Config.ColorVisible 
        highlight.OutlineColor = Config.ColorVisible
        highlight.FillTransparency = 1 - Config.OpacityVisible
        highlight.OutlineTransparency = (1 - Config.OpacityVisible) * 0.5
        highlight.Adornee = char
        highlight.Parent = espFolder

        local line = Instance.new("LineHandleAdornment")
        line.Name = "BlueLine"
        line.Adornee = root
        line.Parent = espFolder
        line.Length = Config.LINE_LENGTH
        line.Thickness = Config.LINE_THICKNESS
        line.Color3 = Config.ColorVisible
        line.Transparency = 1 - Config.OpacityVisible
        line.ZIndex = 10
        line.AlwaysOnTop = false
        line.CFrame = CFrame.new(-Config.OFFSET_LEFT, 1, 0)

        local box = Instance.new("BoxHandleAdornment")
        box.Name = "YellowBoxBody"
        box.Adornee = root
        box.Parent = espFolder
        box.Size = Config.BOX_SIZE
        box.Color3 = Config.BOX_COLOR
        box.Transparency = Config.BOX_TRANSPARENCY
        box.ZIndex = 5
        box.AlwaysOnTop = true
    end)
end

local function UpdateESP()
    if not Config.ESPActive or isDestroyed then return end
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character and LP.Character then
            local char = plr.Character
            local espFolder = char:FindFirstChild(Config.ESP_NAME)
            if not espFolder then
                CreateESP(plr)
                espFolder = char:FindFirstChild(Config.ESP_NAME)
            end
            if espFolder then
                local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
                local head = char:FindFirstChild("Head") or root
                local line = espFolder:FindFirstChild("BlueLine")
                local highlight = espFolder:FindFirstChild("BodyHighlight")
                if root and head and line and highlight then
                    local isVisible = CheckESPStatus(head)
                    if isVisible then
                        highlight.FillColor = Config.ColorVisible
                        highlight.OutlineColor = Config.ColorVisible
                        highlight.FillTransparency = 1 - Config.OpacityVisible
                        highlight.OutlineTransparency = (1 - Config.OpacityVisible) * 0.5
                        line.Color3 = Config.ColorVisible
                        line.Transparency = 1 - Config.OpacityVisible
                    else
                        highlight.FillColor = Config.ColorBlocked
                        highlight.OutlineColor = Config.ColorBlocked
                        highlight.FillTransparency = 1 - Config.OpacityBlocked
                        highlight.OutlineTransparency = (1 - Config.OpacityBlocked) * 0.5
                        line.Color3 = Config.ColorBlocked
                        line.Transparency = 1 - Config.OpacityBlocked
                    end
                end
            end
        end
    end
end

